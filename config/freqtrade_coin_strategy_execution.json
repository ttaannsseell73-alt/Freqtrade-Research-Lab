{
  "$schema": "https://schema.freqtrade.io/schema.json",
  "max_open_trades": -1,
  "stake_currency": "USDT",
  "stake_amount": 1000,
  "tradable_balance_ratio": 0.99,
  "fiat_display_currency": "USD",
  "dry_run": true,
  "dry_run_wallet": 1000000000,
  "cancel_open_orders_on_exit": false,
  "trading_mode": "futures",
  "margin_mode": "isolated",
  "liquidation_buffer": 0.05,
  "futures_funding_rate": 0.0,
  "fee": 0.0005,
  "dataformat_ohlcv": "feather",
  "entry_pricing": {
    "price_side": "same",
    "use_order_book": true,
    "order_book_top": 1
  },
  "exit_pricing": {
    "price_side": "same",
    "use_order_book": true,
    "order_book_top": 1
  },
  "exchange": {
    "name": "binance",
    "key": "",
    "secret": "",
    "sandbox": true,
    "skip_pair_validation": true,
    "ccxt_config": {
      "enableRateLimit": true,
      "options": {
        "defaultType": "future"
      }
    },
    "ccxt_async_config": {
      "enableRateLimit": true,
      "options": {
        "defaultType": "future"
      }
    },
    "pair_whitelist": [],
    "pair_blacklist": []
  },
  "pairlists": [
    {
      "method": "StaticPairList",
      "allow_inactive": true
    }
  ]
}
